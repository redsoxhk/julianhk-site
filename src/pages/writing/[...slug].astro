---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PostLayout from '../../layouts/PostLayout.astro';

/**
 * One page per post. Astro builds these at compile time, so every post is
 * a plain static HTML file by the time it reaches Cloudflare.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout title={post.data.title} description={post.data.description} date={post.data.date}>
  <Content />
</PostLayout>
