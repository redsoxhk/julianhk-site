---
/**
 * PostLayout — wraps a single writing post. The post's MDX body renders
 * into the <slot />, inside `.prose` so paragraphs, lists, images and any
 * embedded components pick up the site's typography.
 */
import BaseLayout from './BaseLayout.astro';
import Spectrum from '../components/Spectrum.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
}

const { title, description, date } = Astro.props;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} — Julian Helguero-Kelley`} description={description}>
  <article>
    <header class="pagehead">
      <p class="postmeta">
        <time datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
      </p>
      <h1 class="pagehead__title">{title}</h1>
      <Spectrum />
      <p class="pagehead__intro">{description}</p>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>

  <a class="backlink" href="/writing/">← All writing</a>
</BaseLayout>
